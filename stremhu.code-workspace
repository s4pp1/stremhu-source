{
  "folders": [
    {
      "path": ".",
      "name": "Root",
    },
    {
      "path": "client",
      "name": "UI",
    },
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder:Root}/.conda/bin/python",
    "files.associations": {
      "*.spec": "python",
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit",
    },
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit",
        "source.fixAll.ruff": "explicit",
      },
    },
    "ruff.enable": true,
    "basedpyright.analysis.autoImportCompletions": true,
    "python.languageServer": "None",
    "python.terminal.activateEnvInCurrentTerminal": true,
    "terminal.integrated.env.osx": {
      "PATH": "${workspaceFolder:Root}/.conda/bin:${env:PATH}",
    },
    "terminal.integrated.env.linux": {
      "PATH": "${workspaceFolder:Root}/.conda/bin:${env:PATH}",
    },
    "terminal.integrated.env.windows": {
      "PATH": "${workspaceFolder:Root}/.conda/Scripts;${workspaceFolder:Root}/.conda;${env:PATH}",
    },
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder:Root}",
  },
}
