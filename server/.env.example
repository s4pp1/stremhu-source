# Környezet típusa (true: fejlesztői mód belső route-okkal, false: éles mód)
IS_DEV=true

# A hoszt gép helyi IP címe (pl. 192.168.1.100)
HOST_IP=192.168.1.100

# A szerver portja (alapértelmezett: 7070)
PORT=7070

# Rendszerkönyvtár elérési útja (adatbázis, tanúsítványok stb.)
SYSTEM_DIR=./data

# A lefordított webes kliens (frontend) könyvtára
CLIENT_PATH=./client/dist

# Alapértelmezett letöltési mappa (ha nincs megadva DOWNLOADS_DIR)
DEFAULT_DOWNLOADS_DIR=./downloads

# Opcionális letöltési mappa felülbírálás
# DOWNLOADS_DIR=/path/to/downloads

# Opcionális reverse proxy domain (pl. stremhu.example.com)
# REVERSE_PROXY_DOMAIN=
