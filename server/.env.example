# ==============================================================================
# StremHU Source - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' or '.env.local' to configure your local environment.
# Real environment variables (e.g. from docker-compose) automatically override
# any values set in .env files.
# ==============================================================================

# Node Environment Mode (production / development / test)
# ------------------------------------------------------------------------------
NODE_ENV=production

# FastAPI Server Port
# ------------------------------------------------------------------------------
PORT=4300

# Libtorrent Listening Port
# ------------------------------------------------------------------------------
LIBTORRENT_PORT=6881

# Cryptographic Session Signatures Key (optional)
# ------------------------------------------------------------------------------
# Leave unset for plug & play: on first start a strong random key is generated and
# stored in data/system/session_secret (keep the data volume). Set it only if you
# manage the key yourself: at least 32 random characters. The old public default
# "stremhu-source" is never used. SESSION_SECRET_FILE moves the generated key file.
# SESSION_SECRET=

# StremHU Catalog URL
# ------------------------------------------------------------------------------
STREMHU_CATALOG_URL=https://catalog.stremhu.app
